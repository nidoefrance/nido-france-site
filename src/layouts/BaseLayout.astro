---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'NIDO France — Nigerians In Diaspora Organisation Europe, France Chapter.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href={url('images/logo.jpg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Enriqueta:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · NIDO France</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
