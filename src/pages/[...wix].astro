---
/**
 * Emits one static redirect page per entry in src/redirects.ts, at the OLD
 * Wix path. Each page: meta-refresh to the new URL, rel=canonical to the new
 * URL (SEO), noindex, and a visible "This page has moved" fallback link.
 */
import { redirects } from '../redirects';
import { url } from '../lib/site';

export function getStaticPaths() {
  return redirects.map((entry) => ({
    params: { wix: entry.from.replace(/^\/+/, '').replace(/\/+$/, '') },
    props: { to: entry.to },
  }));
}

const { to } = Astro.props;
const target = url(to);
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <title>This page has moved</title>
    <style>
      body {
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        margin: 4rem auto;
        max-width: 32rem;
        padding: 0 1.25rem;
        line-height: 1.6;
        color: #1a1a1a;
      }
      a { color: #0645ad; }
    </style>
  </head>
  <body>
    <p>This page has moved, redirecting&hellip;</p>
    <p>If you are not redirected automatically, <a href={target}>continue to {target}</a>.</p>
  </body>
</html>
