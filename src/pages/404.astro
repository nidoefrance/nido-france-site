---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { url } from '../lib/site';

const newsUrl = url('news');
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found">
  <!--
    Safety net for legacy Wix blog URLs that have no explicit entry in
    src/redirects.ts — e.g. the two /single-post/ articles the migration spec
    listed but that were never actually published, or any monthly archive URL
    not enumerated. Those all belong on the NewsRoom index rather than a 404.
    Explicitly mapped URLs are handled at build time by src/pages/[...wix].astro
    and never reach this page.
  -->
  <script is:inline define:vars={{ newsUrl, baseUrl }}>
    (function () {
      var p = ('/' + window.location.pathname.slice(baseUrl.length)).replace(/\/{2,}/g, '/');
      if (/^\/(single-post|events|post|blog)(\/|$)/.test(p)) {
        window.location.replace(newsUrl);
      }
    })();
  </script>

  <section style="padding: 4rem 0; text-align: center;">
    <Container class="prose">
      <h1>404 — Page Not Found</h1>
      <p>The page you are looking for doesn't exist or has moved.</p>
      <p><a href={url()}>&larr; Back to home</a></p>
    </Container>
  </section>
</BaseLayout>
