---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import Container from '../components/Container.astro';
import { url } from '../lib/site';

const allNews = await getCollection('news', ({ data }) => !data.draft);
const latestNews = allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);

const bannerUrl = url('images/banner.jpg');
---

<BaseLayout title="Home">
  <section class="hero" style={`background-image: url(${bannerUrl});`}>
    <div class="hero__content">
      <h1>NIDO France</h1>
      <p>Nigerians In Diaspora Organisation — Europe, France Chapter</p>
      <p>Passion &middot; Experience &middot; Leadership — In Pursuit of National Development</p>
    </div>
  </section>

  <section>
    <div class="band-heading">
      <h2>NewsRoom</h2>
    </div>
    <Container>
      <div class="news-grid">
        {latestNews.map((entry) => <NewsCard entry={entry} />)}
      </div>
      <p><a href={url('news')}>See all NewsRoom &rarr;</a></p>
    </Container>
  </section>
</BaseLayout>
