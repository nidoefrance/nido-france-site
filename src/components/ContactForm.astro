---
import { url } from '../lib/site';

// TODO: replace with the real Formspree form ID once created at https://formspree.io
// (Settings > "Your Forms" > copy the ID from the endpoint, e.g. "f/abcd1234").
const FORMSPREE_ID = 'YOUR_FORM_ID';
const formAction = `https://formspree.io/f/${FORMSPREE_ID}`;
const thankYouUrl = new URL(url('contact/thank-you'), Astro.site ?? Astro.url.origin).toString();
---

<form class="contact-form" action={formAction} method="POST">
  <input type="hidden" name="_subject" value="New message from nidoefrance.org" />
  <input type="hidden" name="_next" value={thankYouUrl} />

  <div>
    <label for="name">Name *</label>
    <input type="text" id="name" name="name" required />
  </div>

  <div>
    <label for="email">Email *</label>
    <input type="email" id="email" name="email" required />
  </div>

  <div>
    <label for="subject">Subject</label>
    <input type="text" id="subject" name="subject" />
  </div>

  <div>
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="6"></textarea>
  </div>

  <button type="submit">Send</button>
</form>
